#include <stdio.h>
#include "stm32f4xx.h"

void delay (void)
{
	 for (volatile unsigned int i=0; i<500000;i++);
}

int main (void)
{
	RCC->AHB1ENR|=(1<<0);

	GPIOA->MODER&=~(3<<(5*2));
	GPIOA->MODER|=(1<<(5*2));

	  while (1)
	    {
	        // LED ON
	        GPIOA->BSRR = (1 << 5);

	        delay();

	        // LED OFF
	        GPIOA->BSRR = (1 << 21);

	        delay();
	    }
}



