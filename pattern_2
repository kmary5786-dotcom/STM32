		#include <stdio.h>
		#include "stm32f4xx.h"

		void delay (void)
		{
			 for (volatile unsigned int i=0; i<500000;i++);
		}

		int main (void)
		{
			//D13->PA5
			//D12->PA6
			//D11->PA7
			//D7->PA8
      RCC->AHB1ENR|=(1<<0);
			GPIOA->MODER &=~((3<<(5*2))|(3<<(6*2))|(3<<(7*2))|(3<<(8*2)));
			GPIOA->MODER |=((1<<(5*2))|(1<<(6*2))|(1<<(7*2))|(1<<(8*2)));

			 while (1)
			    {
			        for (int i = 5; i <= 8; i++)
			        {
			            GPIOA->BSRR = (1U << i);
			            delay();
			            GPIOA->BSRR = (1U << (i + 16));
			        }
			        // Backward: 0100 -> 0010

			        for (int i = 7; i >= 6; i--)
			        {
			            GPIOA->BSRR = (1U << i);
			            delay();
			            GPIOA->BSRR = (1U << (i + 16));
			        }
			    }
}



